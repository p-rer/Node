<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>CS0067</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Node/Editor/ViewModel/NodeEditorViewModel.cs" Link="Production/NodeEditorViewModel.cs" />
    <Compile Include="../../Node/Editor/NodeTypeInfo.cs" Link="Production/NodeTypeInfo.cs" />
    <Compile Include="../../Node/Graph/SharedGraphUpdateState.cs" Link="Production/SharedGraphUpdateState.cs" />
    <Compile Include="../../Node/Graph/Snapshot/NamedGraphSnapshot.cs" Link="Production/NamedGraphSnapshot.cs" />
    <Compile Include="../../Node/Editor/ViewModel/TabViewModel.cs" Link="Production/TabViewModel.cs" />
    <Compile Include="../../Node/Editor/ViewModel/GraphLibraryViewModel.cs" Link="Production/GraphLibraryViewModel.cs" />
    <!-- The SDK ships these assemblies; no YMM4 installation or NuGet restore is needed. -->
    <Reference Include="Newtonsoft.Json" HintPath="$(MSBuildSDKsPath)/../Newtonsoft.Json.dll" />
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll" />
  </ItemGroup>
</Project>
