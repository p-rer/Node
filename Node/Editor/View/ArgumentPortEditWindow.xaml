<Window x:Class="Node.Editor.View.ArgumentPortEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Node.Localize"
        Title="{x:Static loc:TextUi.ArgumentPortDialogTitle}"
        Width="320" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <StackPanel Margin="12">
        <TextBlock Text="{x:Static loc:TextUi.ArgumentPortNameLabel}" Margin="0,0,0,4" />
        <TextBox x:Name="NameTextBox" Margin="0,0,0,8" />
        <TextBlock Text="{x:Static loc:TextUi.ArgumentPortTypeLabel}" Margin="0,0,0,4" />
        <ComboBox x:Name="KindComboBox"
                  DisplayMemberPath="Name"
                  SelectedValuePath="Kind"
                  Margin="0,0,0,8" />
        <TextBlock x:Name="ErrorTextBlock"
                   Text="{x:Static loc:TextUi.ArgumentPortNameInvalid}"
                   Foreground="Red"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static loc:TextUi.OkButtonLabel}"
                    Width="80" Margin="0,0,6,0"
                    IsDefault="True"
                    Click="OkButton_Click" />
            <Button Content="{x:Static loc:TextUi.CancelButtonLabel}"
                    Width="80"
                    IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>