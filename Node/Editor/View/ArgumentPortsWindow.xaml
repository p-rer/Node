<Window x:Class="Node.Editor.View.ArgumentPortsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Node.Localize"
        Title="{x:Static loc:TextUi.EditArgumentPortsTitle}"
        Width="380" Height="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="PortListBox"
                     Grid.Column="0"
                     DisplayMemberPath="DisplayText"
                     SelectionChanged="PortListBox_SelectionChanged"
                     MouseDoubleClick="EditButton_Click" />
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <Button x:Name="AddButton" Content="{x:Static loc:TextUi.ArgumentPortAddLabel}"
                        Width="80" Margin="0,0,0,6" Click="AddButton_Click" />
                <Button x:Name="EditButton" Content="{x:Static loc:TextUi.ArgumentPortEditLabel}"
                        Width="80" Margin="0,0,0,6" Click="EditButton_Click" />
                <Button x:Name="DeleteButton" Content="{x:Static loc:TextUi.ArgumentPortDeleteLabel}"
                        Width="80" Margin="0,0,0,6" Click="DeleteButton_Click" />
                <Button x:Name="UpButton" Content="{x:Static loc:TextUi.MoveUpToolTip}"
                        Width="80" Margin="0,0,0,6" Click="UpButton_Click" />
                <Button x:Name="DownButton" Content="{x:Static loc:TextUi.MoveDownToolTip}"
                        Width="80" Click="DownButton_Click" />
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{x:Static loc:TextUi.OkButtonLabel}"
                    Width="80" Margin="0,0,6,0"
                    IsDefault="True"
                    Click="OkButton_Click" />
            <Button Content="{x:Static loc:TextUi.CancelButtonLabel}"
                    Width="80"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>