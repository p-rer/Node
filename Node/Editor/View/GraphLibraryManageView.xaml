<UserControl x:Class="Node.Editor.View.GraphLibraryManageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModel="clr-namespace:Node.Editor.ViewModel"
             xmlns:snapshot="clr-namespace:Node.Graph.Snapshot"
             xmlns:loc="clr-namespace:Node.Localize"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="420"
             d:DataContext="{d:DesignInstance viewModel:GraphLibraryViewModel}">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{x:Static loc:TextUi.GraphLibraryToolName}"
                   FontWeight="Bold"
                   Margin="0,0,0,8" />

        <ListBox Grid.Row="1"
                 x:Name="EntryListBox"
                 ItemsSource="{Binding Entries}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type snapshot:NamedGraphSnapshot}">
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,4,0"
                                 VerticalContentAlignment="Center" />

                        <Button Grid.Column="1" Content="↑" Width="24" Margin="2,0"
                                Click="MoveUpButton_Click" Tag="{Binding}"
                                ToolTip="{x:Static loc:TextUi.MoveUpToolTip}" />
                        <Button Grid.Column="2" Content="↓" Width="24" Margin="2,0"
                                Click="MoveDownButton_Click" Tag="{Binding}"
                                ToolTip="{x:Static loc:TextUi.MoveDownToolTip}" />
                        <Button Grid.Column="3" Content="×" Width="24" Margin="2,0"
                                Click="DeleteButton_Click" Tag="{Binding}"
                                ToolTip="{x:Static loc:TextUi.DeleteGraphToolTip}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>